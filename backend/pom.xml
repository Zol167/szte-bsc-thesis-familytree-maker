<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version> <!-- Stabil Spring Boot 3 verzió -->
        <relativePath/> 
    </parent>

    <groupId>hu.szte</groupId>
    <artifactId>familytree</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>FamilyTreeMaker</name>
    <description>Szakdolgozat - Családfakutató webalkalmazás backend</description>

    <properties>
        <java.version>21</java.version> <!-- Ha régebbi Javát használsz, írd át 17-re -->
        <!-- A Boot 3.3 által kezelt 1.19.8 nem működik Docker 29-cel (túl régi Docker API verzió) -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Webes végpontokhoz (REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Neo4j gráfadatbázis kapcsolat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>

        <!-- Teszteléshez -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- A Mockitót nem használjuk (a DB logikát valódi Neo4j-jel teszteljük). A Boot 3.3 által hozott
                 Byte Buddy nem támogatja a Java 25-öt, a Spring tesztfigyelője pedig minden @SpringBootTest-ben
                 inicializálná a Mockitót, ezért kizárjuk. -->
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Integrációs tesztek valódi Neo4j-jel Dockerben (mvn verify) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- A *IT osztályokat futtatja a 'mvn verify' (a 'mvn test' csak az egységteszteket) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
